#---------------------------------------------------------------------
#
# Dockerfile for the OpenAirInterface SMF service
#   Valid for CentOS Stream 10
#
#---------------------------------------------------------------------

#---------------------------------------------------------------------
# BUILDER IMAGE
#---------------------------------------------------------------------

FROM quay.io/centos/centos:stream10 AS oai-smf-builder

ENV IS_DOCKERFILE=1

# meson and ninja-build come from CRB; EPEL is enabled for the packages
# build_helper.smf pulls from it. The rest are in BaseOS/AppStream.
RUN dnf config-manager --set-enabled crb && \
    dnf install epel-release -y && \
    dnf update -y && \
    # Log the exact OS release used for the build.
    cat /etc/os-release && \
    dnf install -y \
        psmisc \
        git \
        diffutils \
        libasan \
        wget \
        file && \
    # Libraries built from source are installed under /usr/local, which is not
    # on the default loader path on EL. This is also needed for the ldd check.
    echo "/usr/local/lib" > /etc/ld.so.conf.d/local-lib.conf && \
    echo "/usr/local/lib64" >> /etc/ld.so.conf.d/local-lib.conf

# Git configuration
RUN git config --global https.postBuffer 123289600 && \
    git config --global http.sslverify false

# Copy source code
WORKDIR /openair-smf
COPY . /openair-smf

# Install and Build SMF
WORKDIR /openair-smf/build/scripts
RUN ./build_smf --install-deps --force
RUN ./build_smf --clean --Verbose --build-type Release --jobs && \
    ldd /openair-smf/build/smf/build/smf && \
    mv /openair-smf/build/smf/build/smf /openair-smf/build/smf/build/oai_smf

FROM mikefarah/yq:latest AS yq-source

#---------------------------------------------------------------------
# TARGET IMAGE
#---------------------------------------------------------------------
FROM quay.io/centos/centos:stream10-minimal AS oai-smf
ENV TZ=Europe/Paris

RUN microdnf update -y && \
    microdnf install -y \
# Timezone data, and debugging/networking utilities
      tzdata \
      procps-ng \
      psmisc \
      net-tools \
      iputils \
      tcpdump \
# Runtime dependencies of oai_smf
      libicu \
      boost \
      libevent \
      nettle \
      findutils && \
    microdnf clean all -y && \
    rm -rf /var/cache/yum /var/cache/dnf

# Copy executable and generated libraries
WORKDIR /openair-smf/bin
COPY --from=oai-smf-builder \
    /openair-smf/build/smf/build/oai_smf \
    /openair-smf/scripts/healthcheck.sh \
    ./
COPY --from=yq-source /usr/bin/yq /usr/bin

# The libraries built from source, plus the NAS and NGAP objects built with
# the SMF itself. pistache (meson) and nghttp2 (autotools) install into lib,
# the CMake-built spdlog, fmt, yaml-cpp and cpr into lib64.
COPY --from=oai-smf-builder \
    /usr/local/lib/libpistache.so* \
    /usr/local/lib/libnghttp2_asio.so \
    /usr/local/lib/libnghttp2_asio.so.1 \
    /usr/local/lib64/libspdlog.so \
    /usr/local/lib64/libfmt.so \
    /usr/local/lib64/libyaml-cpp.so.0.* \
    /usr/local/lib64/libcpr.so.1* \
    /openair-smf/build/smf/build/nas/libNAS.so \
    /openair-smf/build/smf/build/ngap/libNGAP.so \
    /usr/lib64/

RUN ldconfig && \
    ldd /openair-smf/bin/oai_smf && \
    # ldd exits 0 even when a library is missing, so check its output
    ! ldd /openair-smf/bin/oai_smf | grep -q 'not found'

WORKDIR /openair-smf/etc
COPY --from=oai-smf-builder \
    /openair-smf/etc/config.yaml ./

WORKDIR /openair-smf

# Expose ports
EXPOSE 80/tcp 9090/tcp 8805/udp

# Configure healthcheck
HEALTHCHECK --interval=10s \
            --timeout=15s \
            --retries=6 \
    CMD /openair-smf/bin/healthcheck.sh

CMD ["/openair-smf/bin/oai_smf", "-c" , "/openair-smf/etc/config.yaml", "-o"]
